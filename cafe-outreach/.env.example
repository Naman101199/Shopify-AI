# Google Places API key
# Get it from: console.cloud.google.com > APIs & Services > Enable "Places API"
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Programmable Search Engine ID (for email + Instagram discovery fallback)
# Setup: programmablesearchengine.google.com > Create > search the entire web
# The Places API key above also works as the API key for Custom Search
GOOGLE_SEARCH_CX=your_programmable_search_engine_id_here

# How many cafes to find per run (default: 10)
DAILY_TARGET=10
