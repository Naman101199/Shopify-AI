# Google Places API key
# Get it from: console.cloud.google.com > APIs & Services > Enable "Places API"
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Gmail OAuth credentials (paths relative to cafe-outreach/)
GMAIL_CREDS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# How many cafes to find and draft per day (default: 10)
DAILY_TARGET=10
